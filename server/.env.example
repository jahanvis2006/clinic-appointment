# Server port
PORT=4000

# SQLite database file (relative to server/prisma)
DATABASE_URL="file:./dev.db"

# Secret used to sign JWTs - change this in production
JWT_SECRET="clinicflow_dev_secret_change_me"

# JWT expiry
JWT_EXPIRES_IN="7d"

# Allowed CORS origin (Vite dev server / Codespaces forwarded URL)
CLIENT_ORIGIN="http://localhost:5173"
